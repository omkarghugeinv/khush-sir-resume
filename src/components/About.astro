---
import { siteConfig } from "../config";
const paragraphs = siteConfig.aboutMe.split('\n').filter(p => p.trim() !== '');
---

<section id="about" class="px-8 py-16 sm:px-12 sm:py-24 md:px-16 md:py-32 lg:px-24 bg-slate-50/50">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
      
      <div class="lg:col-span-4 lg:sticky lg:top-24">
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 tracking-tight">
          About Me
        </h2>
        <div
          class="w-20 h-1.5 mt-6 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        ></div>
      </div>

      <div class="lg:col-span-8">
        <div class="space-y-6 text-base sm:text-lg md:text-xl text-gray-600 leading-relaxed font-medium">
          {paragraphs.map((paragraph) => (
            <p>{paragraph.trim()}</p>
          ))}
        </div>

        <div class="mt-16 pt-10 border-t border-gray-200/60">
          <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest mb-6">
            Core Skills
          </h3>
          <div class="flex flex-wrap gap-3 sm:gap-4">
            {
              siteConfig.skills.map((skill) => (
                <span class="px-5 py-2.5 bg-white text-gray-800 rounded-xl text-sm sm:text-base font-semibold shadow-sm border border-gray-100 hover:shadow-md hover:border-gray-200 hover:-translate-y-0.5 transition-all duration-300">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
